{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "/js/*": ["web/js/*"],
      "/extensions/*": ["web/extensions/*"],
      "yjs": ["tooling/node_modules/yjs"],
      "facet/context-item": ["web/sdk/context-item.js"],
      "facet/strategy-type": ["web/sdk/strategy-type.js"],
      "facet/command-type": ["web/sdk/command-type.js"],
      "facet/ops": ["web/sdk/ops.js"],
      "facet/sandbox": ["web/sdk/sandbox.js"],
      "facet/ui": ["web/sdk/ui.js"],
      "facet/model": ["web/sdk/model.js"],
      "facet/item-utils": ["web/sdk/item-utils.js"],
      "facet/registry": ["web/sdk/registry.js"],
      "facet/version": ["web/sdk/version.js"],
      "facet/utils/html": ["web/js/utils/html.js"]
    }
  },
  "include": [
    "../web/js/**/*.js",
    "../web/js/types/**/*.d.ts",
    "../web/sdk/**/*.js",
    "../web/extensions/**/*.js"
  ],
  "exclude": [
    "../web/js/vendor/**",
    "node_modules"
  ]
}
